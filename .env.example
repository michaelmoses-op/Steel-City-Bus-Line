# Copy to .env at repo root (and/or per-app .env.local as needed).

# --- API (services/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Worker (services/worker) ---
WORKER_POLL_INTERVAL_MS=30000

# --- Database (Phase 2+) ---
DATABASE_URL=postgresql://user:password@localhost:5432/steel_city

# --- Redis (Phase 3+) ---
REDIS_URL=redis://localhost:6379

# --- PRT data (Phase 2+) ---
PRT_GTFS_URL=https://www.rideprt.org/developerresources/GTFSS.zip
PRT_GTFSRT_VEHICLES_URL=https://truetime.rideprt.org/gtfsrt-bus/vehicles
PRT_GTFSRT_TRIPS_URL=https://truetime.rideprt.org/gtfsrt-bus/trips
PRT_GTFSRT_ALERTS_URL=https://truetime.rideprt.org/gtfsrt-bus/alerts

# --- Web (apps/web) — exposed to browser ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Maps (Phase 4+) ---
# NEXT_PUBLIC_MAPBOX_TOKEN=
