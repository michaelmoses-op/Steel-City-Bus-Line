{
  "name": "steel-city-bus-line",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@steel-city/mobile",
    "build:packages": "turbo run build --filter=./packages/*",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "otp:fetch-gtfs": "node scripts/otp-fetch-gtfs.mjs",
    "otp:fetch-osm": "node scripts/otp-fetch-osm.mjs",
    "otp:clip-osm": "node scripts/otp-clip-osm.mjs",
    "otp:prepare-osm": "node scripts/otp-fetch-osm.mjs && node scripts/otp-clip-osm.mjs",
    "otp:build": "pnpm otp:prepare-osm && docker compose --profile otp run --rm otp --build --save",
    "otp:up": "docker compose --profile otp up -d otp",
    "otp:down": "docker compose --profile otp stop otp",
    "db:migrate": "pnpm --filter @steel-city/db migrate",
    "gtfs:import": "pnpm --filter @steel-city/worker import:gtfs",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
