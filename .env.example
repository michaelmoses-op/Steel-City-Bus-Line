# Copy to .env at repo root (and/or per-app .env.local as needed).

# --- API (services/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Worker (services/worker) ---
WORKER_POLL_INTERVAL_MS=15000
RT_MAX_AGE_MS=120000
RT_SNAPSHOT_TTL_SEC=120
SSE_INTERVAL_MS=5000

# --- Database (Phase 2+) ---
DATABASE_URL=postgresql://steel_city:steel_city@localhost:5433/steel_city

# --- Redis (Phase 3+) ---
REDIS_URL=redis://localhost:6379

# --- PRT data (Phase 2+) ---
# Static schedule zip — optional; import resolves from PRT dev page if this 404s
PRT_GTFS_URL=https://rideprt.org/contentassets/1bda11b1f5f1408d8e8f99db6d5ebe75/gtfs.zip
PRT_GTFSRT_VEHICLES_URL=https://truetime.rideprt.org/gtfsrt-bus/vehicles
PRT_GTFSRT_TRIPS_URL=https://truetime.rideprt.org/gtfsrt-bus/trips
PRT_GTFSRT_ALERTS_URL=https://truetime.rideprt.org/gtfsrt-bus/alerts

# --- Trip planning (OpenTripPlanner) — pnpm otp:fetch-gtfs && pnpm otp:build && pnpm otp:up ---
OTP_BASE_URL=http://127.0.0.1:8080
GEOCODE_USER_AGENT=SteelCityBusLine/1.0 (local dev; use real contact URL in production)

# --- Web (apps/web) — exposed to browser ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Maps (Phase 4+) — OpenFreeMap needs no API key ---
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
