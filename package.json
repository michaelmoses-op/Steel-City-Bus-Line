{
  "name": "steel-city-bus-line",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=!@steel-city/mobile",
    "build:packages": "turbo run build --filter=./packages/*",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @steel-city/db migrate",
    "gtfs:import": "pnpm --filter @steel-city/worker import:gtfs",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
